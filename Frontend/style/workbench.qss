/*
 * My Schedule visual system
 * Neutral canvas #F2F2F7, white cards #FFFFFF, system blue #007AFF.
 */

QWidget {
    /* 全局默认文字：所有控件继承深色文字、中文字体、13px 常规字重。 */
    color: #1C1C1E;
    font-family: "Noto Sans CJK SC", "Source Han Sans SC", "Microsoft YaHei UI", "Microsoft YaHei", "PingFang SC", "WenQuanYi Micro Hei", sans-serif;
    font-size: 13px;
    font-weight: 400;
}

QMainWindow,
QDialog,
QWidget#authPage,
QWidget#workbenchPage {
    background-color: #F2F2F7;
}

QFrame#authCard,
QFrame#workbenchCard,
QMessageBox {
    background-color: #FFFFFF;
    border: 1px solid #E5E5EA;
    border-radius: 12px;
}

QFrame#accentRail {
    background-color: #007AFF;
    border: none;
    border-radius: 2px;
}

QWidget#topBar,
QWidget#leftColumn,
QWidget#emptyState,
QStackedWidget#taskStack,
QScrollArea#leftScroll,
QScrollArea#leftScroll QWidget#qt_scrollarea_viewport {
    background-color: transparent;
    border: none;
}

QLabel {
    /* 所有 QLabel 的基础样式：透明背景、无边框，具体颜色和字号由 objectName 覆盖。 */
    background-color: transparent;
    border: none;
}

QLabel#authCalendarIcon {
    /* 登录/注册卡片顶部日历图标 label：只固定图标显示高度为 64px。 */
    min-height: 64px;
    max-height: 64px;
}

QLabel#authTitleLabel {
    /* 登录/注册窗口主标题，例如“我的日程”“创建日程账号”：深色、30px、粗体。 */
    color: #1C1C1E;
    font-size: 30px;
    font-weight: 700;
}

QLabel#pageTitleLabel {
    /* 主窗口顶部页面标题“我的日程”：深色、22px、粗体。 */
    color: #1C1C1E;
    font-size: 22px;
    font-weight: 700;
}

QLabel#sectionTitleLabel {
    /* 卡片区块标题，例如“按日期查看”“安排任务”“任务清单”：深色、16px、半粗。 */
    color: #1C1C1E;
    font-size: 16px;
    font-weight: 600;
}

QLabel#fieldLabel,
QLabel#userNameLabel {
    /* 表单字段名和当前用户名，例如“任务名称”“开始时间”“当前用户后的用户名”：深色、14px、半粗。 */
    color: #1C1C1E;
    font-size: 14px;
    font-weight: 600;
}

QLabel#secondaryLabel,
QLabel#helperLabel,
QLabel#utilityLabel,
QLabel#countLabel,
QLabel#reminderUnitLabel {
    /* 次级说明文字、辅助提示、计数和提醒单位文字：灰色、常规字重。 */
    color: #6E6E73;
    font-weight: 400;
}

QLabel#helperLabel,
QLabel#utilityLabel,
QLabel#countLabel,
QLabel#reminderUnitLabel {
    /* 辅助类小字，例如表单提示、当前用户说明、任务数量、天/小时/分钟单位：12px。 */
    font-size: 12px;
}

QLabel#formErrorLabel,
QLabel#loginErrorLabel {
    /* 注册/登录表单错误提示 label：红色文字、浅红背景、红色边框。 */
    color: #C92A24;
    background-color: #FFF0EF;
    border: 1px solid #FFD0CC;
    border-radius: 7px;
    padding: 8px 10px;
}

QLabel#feedbackLabel {
    /* 主窗口反馈提示 label 默认状态：蓝色文字、浅蓝背景、蓝色边框。 */
    color: #0062CC;
    background-color: #F5F9FF;
    border: 1px solid #D7E8FF;
    border-radius: 7px;
    padding: 8px 10px;
}

QLabel#feedbackLabel[kind="success"] {
    /* showFeedback(..., "success") 对应成功提示：绿色文字、浅绿背景、绿色边框。 */
    color: #218C45;
    background-color: #EAF8EF;
    border-color: #CBEFD8;
}

QLabel#feedbackLabel[kind="error"] {
    /* showFeedback(..., "error") 对应失败提示：红色文字、浅红背景、红色边框。 */
    color: #C92A24;
    background-color: #FFF0EF;
    border-color: #FFD0CC;
}

QDialog#reminderDialog {
    background-color: #F7F8FB;
}

QFrame#reminderPanel {
    background-color: #FFFFFF;
    border: 1px solid #D9DEE8;
    border-radius: 12px;
}

QFrame#reminderTimeRail {
    background-color: #007AFF;
    border: none;
    border-radius: 0;
}

QWidget#reminderContent {
    background-color: transparent;
    border: none;
}

QLabel#reminderLabel {
    /* 提醒弹窗左上角“日程提醒”标签：蓝色胶囊，12px 粗体。 */
    color: #0062CC;
    background-color: #F5F9FF;
    border: 1px solid #D7E8FF;
    border-radius: 12px;
    padding: 5px 10px;
    font-size: 12px;
    font-weight: 700;
}

QLabel#reminderSoundBadge {
    /* 提醒弹窗右上角“提醒已触发”标签：棕橙色胶囊，12px 粗体。 */
    color: #9B3A16;
    background-color: #FFF2EA;
    border: 1px solid #FFD7C2;
    border-radius: 12px;
    padding: 5px 10px;
    font-size: 12px;
    font-weight: 700;
}

QLabel#reminderTitle {
    /* 提醒弹窗任务标题，例如“某任务即将开始”：深色、20px、粗体。 */
    color: #1C1C1E;
    font-size: 20px;
    font-weight: 700;
}

QLabel#reminderStartTime {
    /* 提醒弹窗开始时间 label：深蓝文字、浅蓝背景、22px 粗体。 */
    color: #0B3D91;
    background-color: #F2F7FF;
    border: 1px solid #D7E8FF;
    border-radius: 9px;
    padding: 10px 12px;
    font-size: 22px;
    font-weight: 700;
}

QLabel#reminderMetaBadge {
    /* 提醒弹窗分类/优先级小标签：深灰文字、浅灰背景、12px 半粗。 */
    color: #3A3A3C;
    background-color: #F2F2F7;
    border: 1px solid #E5E5EA;
    border-radius: 11px;
    padding: 5px 10px;
    font-size: 12px;
    font-weight: 600;
}

QLabel#filterPill {
    /* 任务表头右侧筛选状态，例如“全部任务”“7月27日”：蓝色胶囊，12px 半粗。 */
    color: #0062CC;
    background-color: #F5F9FF;
    border: 1px solid #D7E8FF;
    border-radius: 12px;
    padding: 5px 10px;
    font-size: 12px;
    font-weight: 600;
}

QLabel#emptyTitleLabel {
    /* 空状态标题，例如“还没有任务”“这一天还没有任务”：深色、17px、半粗。 */
    color: #1C1C1E;
    font-size: 17px;
    font-weight: 600;
}

QFrame#userChip {
    background-color: #FFFFFF;
    border: 1px solid #E5E5EA;
    border-radius: 9px;
}

QLineEdit,
QComboBox,
QDateTimeEdit,
QSpinBox {
    min-height: 38px;
    background-color: #FFFFFF;
    color: #1C1C1E;
    border: 1px solid #D1D1D6;
    border-radius: 8px;
    padding: 0 10px;
    selection-background-color: #007AFF;
    selection-color: #FFFFFF;
    font-size: 14px;
    font-weight: 400;
}

QFrame#authCard QLineEdit {
    min-height: 44px;
    border-radius: 9px;
    font-size: 14px;
}

QLineEdit:hover,
QComboBox:hover,
QDateTimeEdit:hover,
QSpinBox:hover {
    border-color: #A9A9AF;
}

QLineEdit:focus,
QComboBox:focus,
QDateTimeEdit:focus,
QSpinBox:focus {
    background-color: #FFFFFF;
    border: 2px solid #007AFF;
}

QLineEdit:disabled,
QComboBox:disabled,
QDateTimeEdit:disabled,
QSpinBox:disabled {
    color: #8E8E93;
    background-color: #F7F7FA;
    border-color: #E5E5EA;
}

QComboBox::drop-down,
QDateTimeEdit::drop-down {
    width: 28px;
    border: none;
}

QComboBox QAbstractItemView {
    background-color: #FFFFFF;
    color: #1C1C1E;
    border: 1px solid #D1D1D6;
    selection-background-color: #E8F2FF;
    selection-color: #1C1C1E;
    padding: 4px;
    outline: none;
}

QAbstractSpinBox::up-button,
QAbstractSpinBox::down-button {
    width: 16px;
    background-color: transparent;
    border: none;
}

QPushButton {
    min-height: 38px;
    padding: 0 15px;
    color: #1C1C1E;
    background-color: #FFFFFF;
    border: 1px solid #D1D1D6;
    border-radius: 8px;
    font-size: 14px;
    font-weight: 600;
}

QPushButton:hover {
    background-color: #F7F7FA;
    border-color: #A9A9AF;
}

QPushButton:pressed {
    background-color: #EDEDF1;
    border-color: #8E8E93;
}

QPushButton:focus {
    border: 2px solid #007AFF;
}

QPushButton:disabled {
    color: #8E8E93;
    background-color: #F2F2F7;
    border-color: #E5E5EA;
}

QPushButton#primaryButton {
    min-height: 42px;
    color: #FFFFFF;
    background-color: #007AFF;
    border: 1px solid #007AFF;
}

QFrame#authCard QPushButton#primaryButton {
    min-height: 44px;
    border-radius: 9px;
    font-size: 15px;
}

QPushButton#primaryButton:hover {
    background-color: #0A84FF;
    border-color: #0A84FF;
}

QPushButton#primaryButton:pressed {
    background-color: #0062CC;
    border-color: #0062CC;
}

QPushButton#reminderPrimaryButton {
    min-width: 96px;
    min-height: 38px;
    color: #FFFFFF;
    background-color: #1F6FEB;
    border: 1px solid #1F6FEB;
    border-radius: 8px;
}

QPushButton#reminderPrimaryButton:hover {
    background-color: #2F7CF6;
    border-color: #2F7CF6;
}

QPushButton#reminderPrimaryButton:pressed {
    background-color: #0B57D0;
    border-color: #0B57D0;
}

QPushButton#secondaryButton {
    color: #0062CC;
    background-color: #FFFFFF;
    border-color: #D1D1D6;
}

QPushButton#secondaryButton:hover {
    color: #007AFF;
    background-color: #F5F9FF;
    border-color: #A9D1FF;
}

QPushButton#quietButton {
    color: #6E6E73;
    background-color: transparent;
    border-color: transparent;
    font-weight: 500;
}

QPushButton#quietButton:hover {
    color: #1C1C1E;
    background-color: #F7F7FA;
}

QPushButton#linkButton {
    min-height: 28px;
    color: #007AFF;
    background-color: transparent;
    border: none;
    padding: 0 3px;
    font-weight: 600;
}

QPushButton#linkButton:hover {
    color: #0062CC;
    text-decoration: underline;
}

QPushButton#compactButton {
    min-height: 28px;
    padding: 0 10px;
    border-radius: 7px;
    font-size: 13px;
    font-weight: 500;
}

QPushButton#dangerButton {
    color: #FF3B30;
    background-color: #FFFFFF;
    border-color: #FFD0CC;
}

QPushButton#dangerButton:hover {
    color: #D70015;
    background-color: #FFF0EF;
    border-color: #FFAAA3;
}

QPushButton#dangerButton:pressed {
    background-color: #FFE0DD;
}

QPushButton#dangerButton:disabled {
    color: #8E8E93;
    background-color: #F2F2F7;
    border-color: #E5E5EA;
}

QTableWidget#taskTable {
    /* 任务表格正文文字：深色选中态、13px 常规字重，表格内容来自 populateTaskTable。 */
    background-color: #FFFFFF;
    alternate-background-color: #FAFAFC;
    border: 1px solid #E5E5EA;
    border-radius: 9px;
    gridline-color: transparent;
    selection-background-color: #E8F2FF;
    selection-color: #1C1C1E;
    outline: none;
    font-size: 13px;
    font-weight: 400;
}

QTableWidget#taskTable::item {
    border: none;
    border-bottom: 1px solid #E5E5EA;
    padding: 7px 9px;
}

QTableWidget#taskTable::item:hover {
    background-color: #F5F9FF;
}

QTableWidget#taskTable::item:selected {
    color: #1C1C1E;
    background-color: #E8F2FF;
}

QHeaderView::section {
    /* 表格表头文字，例如“任务名称/分类/优先级/开始时间/提醒时间”：灰色、12px、半粗。 */
    min-height: 38px;
    color: #6E6E73;
    background-color: #F7F7FA;
    border: none;
    border-right: 1px solid #E5E5EA;
    border-bottom: 1px solid #E5E5EA;
    padding: 0 9px;
    font-size: 12px;
    font-weight: 600;
}

QHeaderView::section:last {
    border-right: none;
}

QCalendarWidget#scheduleCalendar {
    background-color: #FFFFFF;
    border: none;
}

QCalendarWidget#scheduleCalendar QWidget {
    background-color: transparent;
}

QCalendarWidget#scheduleCalendar QToolButton {
    /* 日历顶部月份/年份和左右切换按钮文字：深色、15px、半粗。 */
    min-height: 26px;
    color: #1C1C1E;
    background-color: transparent;
    border: none;
    border-radius: 6px;
    padding: 0 7px;
    font-size: 15px;
    font-weight: 600;
}

QCalendarWidget#scheduleCalendar QToolButton:hover {
    color: #007AFF;
    background-color: #F5F9FF;
}

QCalendarWidget#scheduleCalendar QToolButton#qt_calendar_prevmonth {
    qproperty-icon: url(:/icons/chevron-left.svg);
}

QCalendarWidget#scheduleCalendar QToolButton#qt_calendar_nextmonth {
    qproperty-icon: url(:/icons/chevron-right.svg);
}

QCalendarWidget#scheduleCalendar QTableView {
    /* 日历日期格子的文字：深色、13px、中等字重；选中日期为蓝底白字。 */
    color: #1C1C1E;
    background-color: #FFFFFF;
    alternate-background-color: #F7F7FA;
    border: none;
    outline: none;
    selection-background-color: #007AFF;
    selection-color: #FFFFFF;
    font-size: 13px;
    font-weight: 500;
}

QCalendarWidget#scheduleCalendar QTableView::item {
    border-radius: 6px;
    padding: 1px;
    font-weight: 500;
}

QCalendarWidget#scheduleCalendar QTableView::item:selected {
    font-weight: 600;
}

QCalendarWidget#scheduleCalendar QHeaderView::section {
    /* 日历星期表头文字：灰色、13px、半粗。 */
    color: #6E6E73;
    background-color: #F7F7FA;
    border: none;
    padding: 0;
    font-size: 13px;
    font-weight: 600;
}

QSplitter#workspaceSplitter::handle {
    background-color: transparent;
}

QMessageBox QLabel {
    /* QMessageBox 内部提示文字 label：最小宽度 250px、深色文字。 */
    min-width: 250px;
    color: #1C1C1E;
    background-color: transparent;
}

QMessageBox#reminderMessageBox QLabel {
    /* 旧提醒消息框的提示文字宽度兜底：最小宽度 330px。 */
    min-width: 330px;
}

QScrollBar:vertical {
    width: 10px;
    margin: 3px;
    background-color: transparent;
}

QScrollBar::handle:vertical {
    min-height: 28px;
    background-color: #C7C7CC;
    border-radius: 4px;
}

QScrollBar::handle:vertical:hover {
    background-color: #A9A9AF;
}

QScrollBar:horizontal {
    height: 10px;
    margin: 3px;
    background-color: transparent;
}

QScrollBar::handle:horizontal {
    min-width: 28px;
    background-color: #C7C7CC;
    border-radius: 4px;
}

QScrollBar::add-line,
QScrollBar::sub-line,
QScrollBar::add-page,
QScrollBar::sub-page {
    width: 0;
    height: 0;
    background-color: transparent;
    border: none;
}
